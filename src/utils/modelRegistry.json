      "mediapipe": {
        "package": "@mediapipe/pose",
        "version": "0.5.1675469404",
        "marker": "pose_web.binarypb",
        "shared": [
          "pose_web.binarypb",
          "pose.js",
          "pose_solution_packed_assets.data",
          "pose_solution_packed_assets_loader.js",
          "pose_solution_simd_wasm_bin.js",
